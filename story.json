  },
  "bar_ask": {
    "dialogues": [
      {
        "speaker": "酒保",
        "text": "「那個人？」酒保擦著杯子，連頭都沒抬。\n「天天都有無數的人進來又離開。你想問的是哪一個？」"
      }
    ],
    "options": [
      {
        "text": "「沒事了。」（回到長廊）",
        "target": "aisle"
      },
      {
        "text": "詢問他這是不是現實",
